      "borrow": [
        "把纸层、剪影和投影关系作为可讨论的材质方向；具体配色与字体仍从当前游戏推导。"
      ],
      "materialBorrow": [
        "局部非文字表面的低强度纸纤维、边缘剪影或单层投影；不得遮盖玩法信息或扩大容器。"
      ],
      "brandNeutralBorrow": [
        "在既有品牌颜色、字体及语义色内试验局部纸边或弱投影，先验收一个代表片段。"
      ],
      "adapt": [
        "输入标签、触控热区、手柄焦点、文本清晰度及阴影性能需在目标游戏重新设计和验证。"
      ],
      "avoid": [
        "照搬网站导航、hero、营销段落和滚动落地页布局。",
        "把装饰阴影作为唯一焦点或状态提示。",
        "替换已锁定的品牌字体、配色或玩法身份色。"
      ],
      "limitations": [
        "网站风格指南，不是游戏UI案例或已认可模板；所列输入是可适配范围，不代表来源完成输入验证。",
        "高密度HUD只可讨论局部材质；不可整屏堆叠纸层。来源代码、字体和图片的复用权需另查。"
      ],
      "humanApproved": false,
      "runtimeVerified": false
    },
