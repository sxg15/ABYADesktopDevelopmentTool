      "borrow": [
        "把拼贴、纸片与手工注记作为叙事表面的候选语言，先明确每层的信息职责。"
      ],
      "materialBorrow": [
        "只在非交互背景或局部边缘使用拼贴接缝；操作文本保持独立、平直且清晰。"
      ],
      "brandNeutralBorrow": [
        "沿用已确认字体、调色和结构，只讨论一个非信息区域的接缝或纸片纹理。"
      ],
      "adapt": [
        "区分可操作控件与装饰贴纸；用统一焦点、阅读顺序和状态机制适配实际输入。"
      ],
      "avoid": [
        "照搬网站布局、营销内容或整页卡片。",
        "把随机旋转、手写字或胶带装饰施加到所有关键数值和控件。",
        "借风格替换已有品牌字体或调色板。"
      ],
      "limitations": [
        "仅网站风格观察，不含游戏过程与状态验证。",
        "高密度界面限制为局部材质；资产许可、中文字体和交互输入均未验证。"
      ],
      "humanApproved": false,
      "runtimeVerified": false
