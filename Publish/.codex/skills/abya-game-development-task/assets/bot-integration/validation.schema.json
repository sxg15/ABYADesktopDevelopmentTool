{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ABYA Bot verification report v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "status", "runId", "target", "provider", "definitionsHash", "archiveHash", "staticChecks", "evidence", "cases", "uncovered"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["static-passed", "runtime-unverified", "passed", "failed", "blocked", "not-applicable"]},
    "runId": {"$ref": "#/$defs/text"}, "target": {"type": "object", "additionalProperties": false,
      "required": ["archiveId", "levelId", "buildId"], "properties": {
        "archiveId": {"$ref": "#/$defs/text"}, "levelId": {"$ref": "#/$defs/text"}, "buildId": {"$ref": "#/$defs/text"}}},
    "provider": {"enum": ["codex", "grok"]},
    "definitionsHash": {"$ref": "#/$defs/hash"}, "archiveHash": {"$ref": "#/$defs/hash"},
    "staticChecks": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["kind", "path", "sha256", "successPointer"], "properties": {
        "kind": {"enum": ["lua-api", "architecture-validate", "architecture-lint"]},
        "path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/hash"},
        "successPointer": {"type": "string"}}}},
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "path", "sha256"], "properties": {
        "id": {"$ref": "#/$defs/text"}, "path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/hash"}}}},
    "cases": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "kind", "definitionId", "status", "detail", "assertions"], "properties": {
        "id": {"$ref": "#/$defs/text"}, "definitionId": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["join", "observation", "accepted-action", "settlement", "restart", "cleanup", "invalid-action", "capacity-limit", "manual-ownership", "client-sync", "difficulty-comparison"]},
        "status": {"enum": ["passed", "failed", "blocked", "not-run"]}, "detail": {"$ref": "#/$defs/text"},
        "assertions": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["evidenceId", "pointer", "operator"], "properties": {
            "evidenceId": {"$ref": "#/$defs/text"}, "pointer": {"$ref": "#/$defs/text"},
            "operator": {"enum": ["equals", "contains", "greaterThan", "lessOrEqual", "changed", "increased", "matches"]},
            "expected": {}, "beforeEvidenceId": {"$ref": "#/$defs/text"}, "beforePointer": {"$ref": "#/$defs/text"}}}}
      }}},
    "uncovered": {"type": "array", "items": {"$ref": "#/$defs/text"}}
  },
  "$defs": {"text": {"type": "string", "minLength": 1},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
