{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ABYA Desktop Development Tool",
  "version": "0.1.0",
  "identifier": "com.abya.desktop-development-tool",
  "build": {
    "beforeDevCommand": "npm run build:cli && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ABYA Desktop Development Tool",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
